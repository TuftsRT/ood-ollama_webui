---
<%
@partition_filter = :gpu
@partition_qos_path = '/etc/ood/config/apps/dashboard/batch_connect/partials/partition_qos.rb'
_partial_path = '/etc/ood/config/apps/dashboard/batch_connect/partials/resource_discovery.erb'
ERB.new(File.read(_partial_path)).result(binding)
%>

cluster: "pax"

bc_dynamic_js: true

form:
  - disclaimer_block
  - partition
  - bc_num_hours
  - num_cores
  - num_memory
  - gpu_type
  - version
  - modeldir
  - datadir
  - ta_qos
  - bc_email_on_started

attributes:
<%= generate_partition_field.indent(2) %>
<%= generate_gpu_type_field.indent(2) %>
<%= generate_num_cores_field.indent(2) %>
<%= generate_num_memory_field.indent(2) %>
<%= generate_num_hours_field.indent(2) %>

  version:
    label: "Open WebUI Version"
    widget: select
    options:
      - ["0.10.2", "0.10.2"]

  modeldir:
    label: "Ollama directory"
    widget: path_selector
    value: "/cluster/tufts/hpc/tools/ollama"
    directory: /cluster/tufts
    show_files: false
    help: |
      Select the parent Ollama directory, not the models subdirectory.
      For example, choose /cluster/tufts/hpc/tools/ollama.
      The models should be located under /cluster/tufts/hpc/tools/ollama/models.
    favorites:
      - /cluster/tufts
      - /cluster/home

  datadir:
    label: "Open WebUI data directory"
    widget: path_selector
    directory: /cluster/tufts
    show_hidden: true
    show_files: false
    help: "Specifies the base directory for storing data such as uploads, cache, and vector database files. If left unset, it defaults to **${HOME}/open-webui/data**."
    favorites:
      - /cluster/tufts
      - /cluster/home

  disclaimer_block:
    widget: text_field
    class: "d-none"
    skip_label: true
<% if File.exist?("/etc/ood/config/apps/dashboard/batch_connect/partials/ai_disclaimer.md")  %>
    help: |
<%= File.read("/etc/ood/config/apps/dashboard/batch_connect/partials/ai_disclaimer.md").indent(11) %>
<%end%>

  ta_qos:
    widget: check_box
    label: "Request priority start"
    cacheable: false
    help: |
      Submits the job with `--qos=interactive` for higher scheduling priority, so it
      starts sooner. Intended for short, small sessions: while the box is checked, the
      resource fields above are automatically capped to the interactive QOS limits and
      a notice below lists them. Leave this box unchecked if your job needs more time
      or resources than those limits allow.
    value: "normal"
    checked_value: "interactive"
    unchecked_value: "normal"
