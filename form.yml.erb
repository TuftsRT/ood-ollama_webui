---
cluster: "pax"

form:
  - bc_num_hours
  - num_cores
  - num_memory
  - gpu_partition
  - gpu_type 
  - version
  - modeldir
  - datadir
  
attributes:
  num_cores:
    widget: "select"
    label: "Cores"
    options:
      - ["2", "2"]
      - ["4", "4"]
      - ["8", "8"]
      - ["12", "12"]
      - ["16", "16"]

  num_memory:
    widget: "select"
    label: "Memory"
    options:
      - ["4GB", "4000"]
      - ["8GB", "8000"]
      - ["16GB", "16000"]
      - ["32GB", "32000"]
      - ["64GB", "64000"]
      - ["96GB", "96000"]       

  gpu_partition:
    widget: "select"
    label: "Partition"
    help: "NOTE: jobs submitted to the preempt partition may get automatically killed to allow higher priority jobs to run"
    options:
      - ["preempt"]
      - ["gpu"]
    value: "preempt"

  gpu_type:
    widget: "select"
    label: "GPU type"
    help: "gpu partition has a100, a100-80GB and p100, preempt partition has all listed gpu types."
    options:
      - ["any"]
      - ["a100"]
      - ["a100-80GB"]
      - ["l40"]
      - ["rtx_a5000"] 
      - ["rtx_a6000"]
      - ["rtx_6000ada"]
    value: "a100"

  version:
    label: Version
    widget: select
    options:
            - ["0.6.4"]

  modeldir:
    label: Model directory
    widget: path_selector
    value: "/cluster/tufts/hpc/tools/ollama/models"
    directory: /cluster/tufts
    favorites:
      - /cluster/tufts
      - /cluster/home

  datadir:
    label: "DATA_DIR"
    widget: path_selector
    directory: /cluster/tufts
    help: "Specifies the base directory for storing data such as uploads, cache, and vector database files. If left unset, it defaults to **${HOME}/open-webui/data**."
    favorites:
      - /cluster/tufts
      - /cluster/home